# Puerto externo e interno del contenedor.
PORT=3002
TZ=Europe/Madrid

# Portainer con repo clonado en /home/daniel/docker/my_terminal/app.
# En desarrollo local puedes dejar APP_PATH=.
APP_PATH=/home/daniel/docker/my_terminal/app

# Carpeta persistente del host. SQLite y datos quedan aqui.
DATA_PATH=/home/daniel/docker/my_terminal/data

# Docker: la base SQLite se guarda en /data/app.sqlite.
# El docker-compose.yml monta DATA_PATH como /data.
DB_FILE=/data/app.sqlite

# URL real que verá la pantalla E1002 desde la WiFi.
# No uses 127.0.0.1 ni localhost.
PUBLIC_BASE_URL=http://IP_DEL_SERVIDOR:3002

# URL interna que Puppeteer renderiza dentro del backend.
# Normalmente dejala vacia; el backend usa http://localhost:${PORT}/eink.
EINK_RENDER_URL=

# Si ADMIN_TOKEN está vacío, el panel queda abierto.
ADMIN_TOKEN=

# Si DEVICE_TOKEN está vacío, los endpoints del dispositivo quedan abiertos.
# Si lo defines, pon el mismo token en el portal WiFi de la pantalla.
DEVICE_TOKEN=

# En Docker normalmente debe ir vacío.
# Solo pon http://127.0.0.1:5173 si usas Vite en desarrollo con tokens activos.
CORS_ORIGIN=

OPENWEATHER_API_KEY=
PUPPETEER_CACHE_DIR=/app/.cache/puppeteer

# Desarrollo local sin Docker:
# DB_FILE=backend/data/app.sqlite
# PUPPETEER_CACHE_DIR=.cache/puppeteer
