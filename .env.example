PORT=3000
TZ=Europe/Madrid
DB_FILE=backend/data/app.sqlite

# URL real que verá la pantalla E1002. No uses 127.0.0.1 ni localhost.
PUBLIC_BASE_URL=http://192.168.1.50:3000

# URL interna que Puppeteer renderiza dentro del backend.
EINK_RENDER_URL=http://127.0.0.1:3000/eink

# Si ADMIN_TOKEN está vacío, el panel queda abierto.
ADMIN_TOKEN=

# Si DEVICE_TOKEN está vacío, los endpoints del dispositivo quedan abiertos.
# Si lo defines, pon el mismo token en el portal WiFi de la pantalla.
DEVICE_TOKEN=

# Necesario si usas el panel desde Vite en desarrollo con tokens activos.
CORS_ORIGIN=http://127.0.0.1:5173

OPENWEATHER_API_KEY=
PUPPETEER_CACHE_DIR=.cache/puppeteer
